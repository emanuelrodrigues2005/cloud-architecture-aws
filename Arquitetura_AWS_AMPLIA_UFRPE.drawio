        <mxCell id="legend-flows" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F2F6E8;strokeColor=#7AA116;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Fluxos de comunicação&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Usuários → Internet Gateway → ALB&lt;/b&gt; (HTTP 80 / HTTPS 443)&lt;br&gt;• &lt;b&gt;ALB → EC2 Aplicação 01/02&lt;/b&gt; (Target Group, HTTP/HTTPS)&lt;br&gt;• &lt;b&gt;EC2 Aplicação ⇄ VPC Peering ⇄ PostgreSQL 5432 / Redis 6379&lt;/b&gt;&lt;br&gt;• &lt;b&gt;PostgreSQL/Redis → NAT Gateway → Internet&lt;/b&gt; (egress HTTPS 443 p/ atualizações)&lt;br&gt;• &lt;b&gt;Administração:&lt;/b&gt; IP admin /32 → Jump Host (SSH 22) → EC2 Aplicação&lt;br&gt;&lt;br&gt;&lt;i&gt;Recursos privados não recebem acesso direto da Internet.&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="520" x="40" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="legend-sg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FDF3F5;strokeColor=#DD344C;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Security Groups (regras resumidas)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&#39;1&#39; cellspacing=&#39;0&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:10px&#39;&gt;&lt;tr&gt;&lt;th align=&#39;left&#39;&gt;SG&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Entrada&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Saída&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SG-ALB-PUBLIC&lt;/td&gt;&lt;td&gt;80/443 de 0.0.0.0/0&lt;/td&gt;&lt;td&gt;80/443 para SG-EC2-WEB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SG-EC2-WEB&lt;/td&gt;&lt;td&gt;80/443 de SG-ALB-PUBLIC; 22 de SG-JUMPHOST&lt;/td&gt;&lt;td&gt;5432 para SG-POSTGRESQL; 6379 para SG-REDIS; 443 para 0.0.0.0/0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SG-JUMPHOST&lt;/td&gt;&lt;td&gt;22 do IP admin /32&lt;/td&gt;&lt;td&gt;22 para SG-EC2-WEB&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SG-POSTGRESQL&lt;/td&gt;&lt;td&gt;5432 de SG-EC2-WEB&lt;/td&gt;&lt;td&gt;443 para 0.0.0.0/0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SG-REDIS&lt;/td&gt;&lt;td&gt;6379 de SG-EC2-WEB&lt;/td&gt;&lt;td&gt;443 para 0.0.0.0/0&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="250" width="520" x="600" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="legend-net" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F5F5F5;strokeColor=#8C4FFF;fontSize=11;fontColor=#232F3E;" value="&lt;b&gt;Planejamento de rede&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&#39;1&#39; cellspacing=&#39;0&#39; cellpadding=&#39;3&#39; style=&#39;border-collapse:collapse;width:100%;font-size:10px&#39;&gt;&lt;tr&gt;&lt;th align=&#39;left&#39;&gt;Recurso&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;CIDR&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Uso&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Application VPC&lt;/td&gt;&lt;td&gt;10.0.0.0/16&lt;/td&gt;&lt;td&gt;Camada de aplicação&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Public Subnet AZ-1&lt;/td&gt;&lt;td&gt;10.0.0.0/24&lt;/td&gt;&lt;td&gt;ALB + EC2 Aplicação 01 + Jump Host&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Public Subnet AZ-2&lt;/td&gt;&lt;td&gt;10.0.1.0/24&lt;/td&gt;&lt;td&gt;ALB + EC2 Aplicação 02&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Data VPC&lt;/td&gt;&lt;td&gt;10.1.0.0/16&lt;/td&gt;&lt;td&gt;Camada de dados&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Public Subnet AZ-1 (NAT)&lt;/td&gt;&lt;td&gt;10.1.0.0/24&lt;/td&gt;&lt;td&gt;NAT Gateway + Elastic IP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Private Subnet AZ-1&lt;/td&gt;&lt;td&gt;10.1.1.0/24&lt;/td&gt;&lt;td&gt;EC2 PostgreSQL (5432)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Private Subnet AZ-2&lt;/td&gt;&lt;td&gt;10.1.2.0/24&lt;/td&gt;&lt;td&gt;EC2 Redis (6379)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
